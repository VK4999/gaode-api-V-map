# gaode地图 API 配置（内置默认值）
# 用户可通过 APP 内登录页面修改，修改后保存到 APP 私有目录
# 申请地址：https://lbs.amap.com/
AMAP_API_KEY='{REPLACE_YOUR_AMAP_API_KEY}'
AMAP_SECURITY_JS_CODE='{REPLACE_YOUR_AMAP_SECURITY_JS_CODE}'

# 地图默认设置
DEFAULT_CENTER=116.397428,39.90923
DEFAULT_ZOOM=12

# 日志配置
LOG_LEVEL=INFO
LOG_FILE=logs/amap_desktop.log
